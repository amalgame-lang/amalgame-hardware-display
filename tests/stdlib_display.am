// Test the SSD1306 driver against a fake I2C bus (no hardware): it must
// init, render to the framebuffer and stream it without crashing, and
// actually push data bytes on Show().

namespace Tests

import Amalgame.Hal
import Amalgame.Hardware.Display

public class FakeI2c implements I2cBus {
    private writes: int
    public FakeI2c() { this.writes = 0 }
    public bool WriteByte(addr: int, value: int) { this.writes = this.writes + 1; return true }
    public int  ReadByte(addr: int) { return 0 }
    public bool WriteReg(addr: int, reg: int, value: int) { this.writes = this.writes + 1; return true }
    public int  ReadReg(addr: int, reg: int) { return 0 }
    public bool WriteBytes(addr: int, bytes: List<int>) { this.writes = this.writes + bytes.Count(); return true }
    public List<int> ReadBytes(addr: int, count: int) { let l: List<int> = new List<int>(); return l }
    public int Writes() { return this.writes }
}

public class FakeClock implements Clock {
    public FakeClock() { }
    public void DelayMs(ms: int) { }
    public void DelayUs(us: int) { }
    public int Millis() { return 0 }
    public int Micros() { return 0 }
}

public class FakeSpi implements SpiBus {
    private xfers: int
    public FakeSpi() { this.xfers = 0 }
    public List<int> Transfer(tx: List<int>) { this.xfers = this.xfers + 1; return tx }
    public int Xfers() { return this.xfers }
}

public class FakeOut implements DigitalOut {
    private edges: int
    public FakeOut() { this.edges = 0 }
    public void Write(level: int) { this.edges = this.edges + 1 }
    public void High() { this.edges = this.edges + 1 }
    public void Low()  { this.edges = this.edges + 1 }
    public void Toggle() { this.edges = this.edges + 1 }
    public int Edges() { return this.edges }
}

public class Program {
    public static void Main(string[] args) {
        var fail: int = 0
        let bus: FakeI2c = new FakeI2c()
        let oled: Ssd1306 = new Ssd1306(bus, 0x3C)
        oled.Begin()
        oled.Clear()
        oled.Pixel(0, 0, true)
        oled.Pixel(127, 63, true)
        oled.HLine(0, 10, 64)
        oled.Rect(0, 16, 40, 20)
        oled.Text(0, 24, "T:23.5C")
        oled.Show()
        // Show streams 1024 fb bytes (+ control bytes) → many writes.
        if (bus.Writes() > 1000) { Console.WriteLine("[PASS] ssd1306 renders + streams (" + String_FromInt(bus.Writes()) + " bytes)") } else { Console.WriteLine("[FAIL] ssd1306 streamed only " + String_FromInt(bus.Writes())); fail = fail + 1 }

        // HD44780 character LCD via I2C backpack.
        let lbus: FakeI2c = new FakeI2c()
        let lcd: Lcd1602 = new Lcd1602(lbus, 0x27, new FakeClock())
        lcd.Clear()
        lcd.SetCursor(0, 0)
        lcd.Print("Amalgame")
        if (lbus.Writes() > 0) { Console.WriteLine("[PASS] lcd1602 init + print (" + String_FromInt(lbus.Writes()) + " writes)") } else { Console.WriteLine("[FAIL] lcd1602 no writes"); fail = fail + 1 }

        // MAX7219 7-seg / matrix over SPI.
        let sp: FakeSpi = new FakeSpi()
        let m: Max7219 = new Max7219(sp)
        m.SetIntensity(5)
        m.SetRow(0, 0x3C)
        if (sp.Xfers() > 0) { Console.WriteLine("[PASS] max7219 spi (" + String_FromInt(sp.Xfers()) + " words)") } else { Console.WriteLine("[FAIL] max7219 no spi"); fail = fail + 1 }

        // TM1637 4-digit clock display (2-wire bit-bang).
        let tclk: FakeOut = new FakeOut()
        let tdio: FakeOut = new FakeOut()
        let seg: Tm1637 = new Tm1637(tclk, tdio, new FakeClock())
        seg.ShowNumber(1234, true)
        if (tclk.Edges() > 0 && tdio.Edges() > 0) { Console.WriteLine("[PASS] tm1637 driven (" + String_FromInt(tclk.Edges()) + " clk edges)") } else { Console.WriteLine("[FAIL] tm1637 not driven"); fail = fail + 1 }

        if (fail == 0) { Console.WriteLine("display: all good") }
    }
}
